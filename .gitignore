# ── Dependencies ─────────────────────────────────────────
node_modules/

# ── Environment & secrets (never commit) ─────────────────
# Real configuration lives in .env files; only the *.env.example templates are committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
ngrok.yml

# ── Archives & dumps (may contain .env, node_modules or data) ──
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.sql.gz
*.dump
*.bak

# ── Build output ─────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ── Tests & coverage ─────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Logs & runtime files ─────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.mail-outbox/
.tmp-*
*.tmp
tmp/
temp/

# ── Editors & operating systems ──────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
