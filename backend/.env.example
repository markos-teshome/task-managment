# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/teamflow
# Migrations only (npm run db:deploy): the direct, NON-pooled address. With Neon, the same URL without
# "-pooler" — migrations over the pooled address can leave Prisma's lock stuck. Optional elsewhere.
# DIRECT_URL=postgresql://...
# Used only by `npm test` (the test suite resets this database).
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/teamflow_test

# ── URLs ──────────────────────────────────────────────────
# APP_URL = the frontend; every email link points here, so it must open on the RECIPIENT's device.
# localhost only works on this computer. To test invitations from another device, see README →
# "Testing from another device" (one HTTPS tunnel to the frontend; then API_URL can be the same URL).
APP_URL=http://localhost:5173            # frontend, used in email links and payment redirects
API_URL=http://localhost:4000            # this API as reachable by Chapa (webhook + callback)
CORS_ORIGINS=http://localhost:5173       # comma-separated

# One-service deployment: this API also serves the built frontend (frontend/dist) on the same address.
# The Docker image sets this to true. Leave false in development (Vite serves the frontend).
SERVE_FRONTEND=false

# ── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false                      # true in production (HTTPS)
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true

# ── Payments (Chapa) ──────────────────────────────────────
CHAPA_SECRET_KEY=                        # Chapa dashboard → Settings → API keys. Use a CHASECK_TEST-… key.
CHAPA_WEBHOOK_SECRET=                    # the "Secret hash" you set in Chapa dashboard → Settings → Webhooks
CHAPA_ALLOW_LIVE=false                   # a live (non-test) key is refused unless this is true
# Chapa must reach API_URL: use a public URL (deployed, or a tunnel such as ngrok) when testing locally.
# Webhook URL to register in Chapa:  <API_URL>/api/v1/payments/webhooks/chapa

# ── Email (SMTP, required) ───────────────────────────────
# Verification, password-reset and invitation emails are sent through this SMTP account.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587                            # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=TeamFlow <you@yourdomain.com>  # optional; defaults to TeamFlow <SMTP_USER>

# ── Seed only (optional) ─────────────────────────────────
# Email of the demo super admin. Platform sign-in emails a one-time code, so use a real mailbox.
# SEED_PLATFORM_ADMIN_EMAIL=ops@yourcompany.com
# Super admins are otherwise created with: PLATFORM_ADMIN_PASSWORD='…' npm run platform-admin -- create <email> <first> <last>

# ── Production checklist (the server refuses to start if a required item is wrong) ──
# NODE_ENV=production
# APP_URL=https://teamflow.yourdomain.com      # https, not localhost
# API_URL=https://teamflow.yourdomain.com      # https; same as APP_URL with SERVE_FRONTEND=true
# CORS_ORIGINS=https://teamflow.yourdomain.com
# COOKIE_SECURE=true
# SERVE_FRONTEND=true
# DATABASE_URL=<pooled address>   DIRECT_URL=<direct address>
# JWT_ACCESS_SECRET=<new random value>          # never reuse the development one
