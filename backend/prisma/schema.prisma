// TeamFlow data model
//
// Tenancy model: shared database, shared schema, row-level ownership via `organizationId`.
// Every tenant-owned table carries `organizationId`. Where Prisma allows it, child rows
// reference their parent through a composite foreign key `(id, organizationId)`, so the
// database itself refuses a task that points at another tenant's project, a membership
// with another tenant's role, etc. Optional references (task assignee, project lead) are
// validated in the service layer because Prisma cannot express optional composite relations.
//
// People inside a tenant are referenced through `Membership`, not `User`. A user is a global
// identity (one email, one password); a membership is that person *inside one organization*.
// This keeps history intact when someone is deactivated and makes cross-tenant assignment
// impossible to express by accident.

generator client {
  provider        = "prisma-client-js"
  // Loads nested relations with one SQL query instead of one query per level. Matters on a remote
  // database, where every round-trip costs ~300 ms (the session context alone has four levels).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED // closed by the platform after the Owner's closure request; data retained, reversible
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

/// PENDING → SUCCEEDED | FAILED | CANCELLED | EXPIRED. SUCCEEDED and FAILED are final.
/// CANCELLED/EXPIRED → SUCCEEDED only when the provider later verifies that the money was taken.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  CHAPA
}

// ───────────────────────── Identity & sessions ─────────────────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique // always stored lower-cased
  passwordHash        String? // null until an invited user accepts
  firstName           String
  lastName            String
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  memberships Membership[]
  sessions    Session[]
  authTokens  AuthToken[]

  @@map("users")
}

/// One row per login. The refresh token is `<sessionId>.<secret>`; only a hash of the
/// secret is stored and it rotates on every refresh. The session also pins the active
/// workspace, so tenant context is always derived server-side.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  membershipId     String?   @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// Single-use, expiring, hashed tokens for email verification, password reset and invitations.
model AuthToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  membershipId String?       @db.Uuid // set for INVITATION tokens
  type         AuthTokenType
  tokenHash    String        @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime      @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ───────────────────────────── Tenancy ─────────────────────────────

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String             @unique
  status               OrganizationStatus @default(ACTIVE)
  // Owner's closure request (D-9). Processing it (status CLOSED) is a platform action; nothing is deleted.
  closureRequestedAt   DateTime?
  closureReason        String?
  closureRequestedById String?            @db.Uuid
  closedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  memberships   Membership[]
  roles         Role[]
  branches      Branch[]
  projects      Project[]
  tasks         Task[]
  subscription  Subscription?
  payments      Payment[]
  activities    ActivityLog[]
  notifications Notification[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  jobTitle       String?
  invitedById    String?          @db.Uuid // who sent the (latest) invitation
  joinedAt       DateTime?
  deactivatedAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: a membership can only hold a role of its own organization.
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitedBy    Membership?  @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invited      Membership[] @relation("MembershipInviter")

  branchMemberships BranchMembership[]
  managedBranches   Branch[]           @relation("BranchManager")

  sessions           Session[]
  authTokens         AuthToken[]
  projectMemberships ProjectMember[]
  ledProjects        Project[]                @relation("ProjectLead")
  createdProjects    Project[]                @relation("ProjectCreator")
  assignedTasks      Task[]                   @relation("TaskAssignee")
  createdTasks       Task[]                   @relation("TaskCreator")
  payments           Payment[]
  activities         ActivityLog[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("memberships")
}

// ───────────────────────────── Branches ─────────────────────────────

/// A branch is a part of one organization (Head Office, Bole Branch …), never a tenant of its own.
/// Every organization has exactly one default branch (partial unique index in the migration).
/// Branches are archived (INACTIVE), never deleted, so projects and history keep their reference.
/// Database-level consistency added in the migration (Prisma cannot express it):
///   (managerId, organizationId) → memberships(id, organizationId): the manager is a member of the same organization.
model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String? // optional short code, unique within the organization
  description    String?
  address        String? // free-form location, optional
  status         BranchStatus @default(ACTIVE)
  isDefault      Boolean      @default(false)
  managerId      String?      @db.Uuid
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      Membership?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      BranchMembership[]
  projects     Project[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("branches")
}

/// A person (membership) in a branch. Both composite FKs share organizationId, so the database refuses a
/// branch member from another organization.
model BranchMembership {
  branchId       String   @db.Uuid
  membershipId   String   @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  branch     Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([branchId, membershipId])
  @@index([membershipId])
  @@map("branch_memberships")
}

// ─────────────────────────── Access control ───────────────────────────

/// Roles are per-organization. System roles (key = OWNER/ADMIN/MANAGER/EMPLOYEE) are created
/// for every new organization; owners on an eligible plan can add custom roles (key = null).
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String? // system role key, null for custom roles
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@map("roles")
}

/// Global permission catalog. Synchronised from code (src/common/constants/permissions.js) on startup.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  group       String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────── Work management ───────────────────────────

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  priority       Priority      @default(MEDIUM)
  startDate      DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  leadId         String?       @db.Uuid // responsible person (a membership of the same org)
  branchId       String?       @db.Uuid // null = organization-wide project
  createdById    String?       @db.Uuid
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Membership?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  // Plus a composite FK (branchId, organizationId) → branches(id, organizationId) added in the migration:
  // a project can only be placed in a branch of its own organization.
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: NoAction)
  createdBy    Membership?     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      ProjectMember[] // the responsible team
  tasks        Task[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([branchId])
  @@map("projects")
}

model ProjectMember {
  projectId      String   @db.Uuid
  membershipId   String   @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  // Both composite FKs share organizationId → project and member must belong to the same tenant.
  project    Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([projectId, membershipId])
  @@index([membershipId])
  @@map("project_members")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  projectId      String     @db.Uuid
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?    @db.Uuid
  createdById    String?    @db.Uuid
  dueDate        DateTime?  @db.Date
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: a task's organization must equal its project's organization.
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee     Membership?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    Membership?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

// ─────────────────────────── SaaS & billing ───────────────────────────

/// Plans live in the database so the platform owner can change pricing and limits without a deploy.
/// `null` limits mean unlimited. `features` holds feature-flag keys (see constants/plans.js).
model SubscriptionPlan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  priceCents  Int      @default(0) // monthly price in minor units of `currency`
  currency    String   @default("ETB")
  maxUsers    Int?
  maxProjects Int?
  maxBranches Int? // active branches incl. the default one; null = unlimited
  features    String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime? // null for the free plan (never expires)
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  planId            String          @db.Uuid
  amountCents       Int
  currency          String
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  txRef             String          @unique // our idempotency key, sent to the provider
  providerReference String?
  checkoutUrl       String?
  failureReason     String?
  providerData      Json?
  initiatedById     String?         @db.Uuid
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  initiatedBy  Membership?      @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("payments")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only business history. `metadata` stores display values (names, titles) captured at the
/// time of the event so history stays readable after records are renamed or deleted.
/// Never put secrets, tokens or passwords in here.
model ActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?  @db.Uuid
  projectId      String?  @db.Uuid // denormalised so a project's timeline is one indexed query
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        Membership?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, entityId]) // a task's history in the task drawer
  @@map("activity_logs")
}

// ─────────────────────────── Notifications ───────────────────────────

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED // recipient no longer active when it was due
}

/// An in-app notification for one member of one organization (the recipient is a membership, so a person in
/// several organizations sees each workspace's notifications only there, and removed members see none).
/// Recipients are always chosen by the server from the business event, never by a client.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  membershipId   String    @db.Uuid
  type           String // catalog in notification.catalog.js
  title          String
  message        String
  link           String? // app path to open, e.g. /tasks?task=<id>
  entityType     String?
  entityId       String?   @db.Uuid
  dedupeKey      String? // the same business event never notifies the same person twice
  inApp          Boolean   @default(true) // false: email-only (the member turned the in-app channel off)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: the recipient must be a membership of the same organization.
  membership   Membership            @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  delivery     NotificationDelivery?

  @@unique([membershipId, dedupeKey])
  @@index([membershipId, inApp, createdAt])
  @@index([membershipId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Email delivery of a notification (transactional outbox): written with the business change, sent after
/// commit by the delivery worker, retried on temporary failures.
model NotificationDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  notificationId String         @unique @db.Uuid
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?
  nextAttemptAt  DateTime       @default(now())
  sentAt         DateTime?
  createdAt      DateTime       @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// A member's choice per notification category in one organization. No row = the category's default.
model NotificationPreference {
  membershipId String   @db.Uuid
  category     String
  inApp        Boolean
  email        Boolean
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, category])
  @@map("notification_preferences")
}

// ─────────────────────────── Platform (TeamFlow operators) ───────────────────────────

/// TeamFlow's own operators. A separate identity from tenant users: no memberships, no tenant sessions,
/// so platform authority can never carry into tenant APIs. Created only by the command line
/// (scripts/platform-admin.js). Sign-in requires password + an emailed one-time code.
model PlatformAdmin {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  firstName           String
  lastName            String
  passwordHash        String
  status              PlatformAdminStatus @default(ACTIVE)
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  sessions   PlatformSession[]
  challenges PlatformLoginChallenge[]
  auditLogs  PlatformAuditLog[]

  @@map("platform_admins")
}

/// Short-lived platform session (8 h absolute, 30 min idle), held in an httpOnly cookie scoped to /api/v1/platform.
model PlatformSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @db.Uuid
  secretHash String
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// Second factor: a 6-digit code emailed after a correct password. Hashed, 10 minutes, 5 attempts, single use.
model PlatformLoginChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_login_challenges")
}

/// Actions taken by platform administrators. Append-only. actorId null = command line.
/// Never put secrets, tokens or passwords in `metadata`.
model PlatformAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor PlatformAdmin? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("platform_audit_logs")
}
