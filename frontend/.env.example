# API base path. Default "/api/v1" works with the Vite dev proxy (see vite.config.js).
# For a separately hosted API, set the full URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Dev server only: extra host names it answers (comma-separated), e.g. the public host of a tunnel used to open
# email links on another device. Put it in .env.local (not committed). Example: VITE_ALLOWED_HOSTS=abcd.ngrok-free.app
VITE_ALLOWED_HOSTS=

